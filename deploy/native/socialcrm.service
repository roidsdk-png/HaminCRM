[Unit]
Description=Hamin CRM native worker runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/socialCRM-current
Environment=NODE_ENV=production
Environment=PATH=/root/socialCRM-tools/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WRANGLER_SEND_METRICS=false
Environment=WRANGLER_WRITE_LOGS=false
Environment=CI=true
Environment=X_LOCAL_OBSERVABILITY=false
Environment=X_LOCAL_EXPLORER=false
MemoryAccounting=true
MemoryMax=1200M
MemorySwapMax=0
OOMScoreAdjust=500
EnvironmentFile=/root/socialCRM/.dev.vars
UMask=0077
ExecStart=/root/socialCRM-tools/node/bin/node /root/socialCRM-current/node_modules/wrangler/bin/wrangler.js dev --config /root/socialCRM-current/dist/server/wrangler.json --env-file /root/socialCRM/.dev.vars --local --persist-to /root/socialCRM/data --ip 127.0.0.1 --port 3010 --upstream-protocol https --log-level info
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
