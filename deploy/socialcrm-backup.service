[Unit]
Description=Hamin SocialCRM database backup
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /root/socialCRM/scripts/backup-production.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/socialCRM/backups /root/socialCRM/data
NoNewPrivileges=true
